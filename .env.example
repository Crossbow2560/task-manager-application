# Set these in your shell before npm start. This file is a reference, not auto-loaded.
PORT=3000
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:55433/taskmanager
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Optional SMTP. Without it, reminders appear in-app only.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=0
SMTP_FROM=Task Manager <reminders@taskmanager.test>
# TLS_CERT_FILE=/absolute/path/cert.pem
# TLS_KEY_FILE=/absolute/path/key.pem
# Use TRUST_PROXY=1 only behind a trusted TLS-terminating reverse proxy.
# Optional local demonstration account seed:
# DEMO_PASSWORD=ChooseYourOwnDemoPassword1
